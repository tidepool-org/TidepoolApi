# Base URL for Tidepool API (all services except OIDC auth)
TIDEPOOL_BASE_URL=https://external.integration.tidepool.org

# Base URL for OIDC authentication endpoints
TIDEPOOL_AUTH_URL=https://auth.external.tidepool.org

# OIDC realm (matches environment)
TIDEPOOL_REALM=integration

# OIDC client credentials (required for auth OIDC tests)
TIDEPOOL_CLIENT_ID=
TIDEPOOL_CLIENT_SECRET=

# Server secret for server-token endpoints (optional, skip those tests if unset)
TIDEPOOL_SERVER_SECRET=
